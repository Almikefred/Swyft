# ── Database (Prisma) ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swyft

# ── Redis (BullMQ + Cache) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Stellar RPC & Horizon ─────────────────────────────────────────────────────
# Both URLs are REQUIRED. The application validates them at startup and will
# refuse to start if they are missing or malformed.
#
# For production deployments, supply these via CI/CD secrets (e.g. GitHub
# Actions secrets: STELLAR_RPC_URL, HORIZON_URL) — never commit real values.
#
# STELLAR_NETWORK must be one of: testnet | mainnet
# STELLAR_NETWORK_PASSPHRASE must match the selected network. The API fails
# closed if the passphrase does not match STELLAR_NETWORK (e.g. a mainnet
# passphrase while STELLAR_NETWORK=testnet).
#
# Testnet values below mirror packages/contract/deployments/TESTNET.md.
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# ── Contract Addresses ────────────────────────────────────────────────────────
# Contract IDs are REQUIRED when STELLAR_NETWORK=testnet. The API fails closed
# if any are missing or do not match the expected testnet deployment.
# Values mirror packages/contract/deployments/TESTNET.md.
POOL_CONTRACT_ID=
FACTORY_CONTRACT_ID=
ROUTER_CONTRACT_ID=

# ── Asset Issuers (testnet) ───────────────────────────────────────────────────
# Public testnet asset issuers. Never commit mainnet issuers here.
USDC_ISSUER=
EURC_ISSUER=

# ── Token List (optional) ─────────────────────────────────────────────────────
# A Uniswap-compatible token list JSON URL. When set, token metadata is
# enriched on startup and weekly.
TOKEN_LIST_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_ISSUER=swyft-api
JWT_AUDIENCE=swyft-client

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001

# ── Internal API key ──────────────────────────────────────────────────────────
# Protects /admin/* and /metrics/db. Set via secret in production.
INTERNAL_API_KEY=change-me-in-production

# ── DB query monitoring ───────────────────────────────────────────────────────
DB_SLOW_QUERY_THRESHOLD_MS=100

# ── Sentry (optional) ────────────────────────────────────────────────────────
# Leave blank to disable error reporting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── OpenTelemetry tracing (optional) ─────────────────────────────────────────
# Leave blank to disable distributed tracing. When set, incoming requests are
# joined to the caller's trace (W3C traceparent) and outgoing HTTP calls this
# service makes carry the trace onward. Points at an OTLP/HTTP collector, e.g.
# http://localhost:4318/v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=swyft-api

# ── Compression ───────────────────────────────────────────────────────────────
COMPRESSION_LEVEL=6

# ── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_LARGE_SWAP_USD=10000
